# ==================================================================
#  JYM CULTURE GYM & SPA - Backend environment configuration
# ==================================================================
#  1. Copy this file:      cp .env.example .env
#  2. Fill in the real values below.
#  3. NEVER commit the .env file (it is already in .gitignore).
# ==================================================================

# ---------------- Server ----------------
# Port the API listens on. The front-end calls this exact port locally.
PORT=5000

# 'development' returns extra detail in error responses.
# 'production' hides internal detail and is what you deploy with.
NODE_ENV=development

# ---------------- CORS ----------------
# Comma-separated list of origins allowed to call this API.
# Use * to allow any origin (fine for local testing and for a public
# static site that is served from a different domain).
# Example for production: CORS_ORIGIN=https://jymculture.com,https://www.jymculture.com
CORS_ORIGIN=*

# ---------------- Admin protection ----------------
# Secret key required by every /api/admin/* route.
# Send it either as:   x-api-key: <value>
#                 or:  Authorization: Bearer <value>
# CHANGE THIS to a long random string before deploying.
# Tip: generate one with   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=change-me-to-a-long-random-string

# ---------------- Storage ----------------
# Where enquiries are stored. Relative paths resolve from the backend folder.
DATA_FILE=./data/enquiries.json

# ---------------- Optional: serve the website too ----------------
# Leave empty to run the API on its own.
# Set it to the website folder (e.g. ../webpages/jym-culture-gym_v6) and the
# same server will also serve index.html, styles.css, images, etc.
STATIC_DIR=

# ---------------- Email notification (Nodemailer / SMTP) ----------------
# If EMAIL_ENABLED=false, OR SMTP_HOST/SMTP_USER/SMTP_PASS are empty, the API
# still accepts and stores every submission - it just skips sending the email.
EMAIL_ENABLED=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# true  -> implicit TLS, normally used with port 465
# false -> STARTTLS, normally used with port 587 (most providers)
SMTP_SECURE=false

SMTP_USER=your-gmail-address@gmail.com

# For Gmail use a 16-character App Password, NOT your normal account password.
# Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_PASS=your-16-char-app-password

# Where the notification email lands (the gym's inbox)
MAIL_TO=JYMCULTURE@gmail.com

# What the email appears to come from. Defaults to SMTP_USER when omitted.
MAIL_FROM="JYM Culture Website <JYMCULTURE@gmail.com>"

# How long (in milliseconds) to wait on the SMTP server before giving up
SMTP_TIMEOUT_MS=10000
